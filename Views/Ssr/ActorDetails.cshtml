@model SimpleMovieDB.Models.ActorModel
@{ ViewData["Title"] = "Actor Details"; Layout = "~/Views/Shared/_SsrLayout.cshtml"; }

<div class="row justify-content-center">
  <div class="col-md-7">
    <h2 class="mb-4">@Model.FirstName @Model.LastName</h2>
    <table class="table table-bordered">
      <tr><th>ID</th><td>@Model.Id</td></tr>
      <tr><th>First Name</th><td>@Model.FirstName</td></tr>
      <tr><th>Last Name</th><td>@Model.LastName</td></tr>
      <tr><th>Rating</th><td>★ @Model.Rating</td></tr>
    </table>

    <h4 class="mt-4">Movies</h4>
    @if (ViewBag.Movies != null && ((List<SimpleMovieDB.Models.MovieModel?>)ViewBag.Movies).Count > 0)
    {
      <ul class="list-group">
        @foreach (var m in (List<SimpleMovieDB.Models.MovieModel?>)ViewBag.Movies)
        {
          <li class="list-group-item">@m!.Title (@m.Year)</li>
        }
      </ul>
    }
    else
    {
      <p class="text-muted">No movies linked.</p>
    }

    <div class="d-flex gap-2 mt-3">
      <a asp-action="Actors" class="btn btn-secondary">Back</a>
      @if (ViewBag.IsAdmin == true)
      {
        <a asp-action="EditActor" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
      }
    </div>
  </div>
</div>
