@model SimpleMovieDB.Models.ActorModel
@{ ViewData["Title"] = "Add Actor"; Layout = "~/Views/Shared/_SsrLayout.cshtml"; }

<div class="row justify-content-center">
  <div class="col-md-6">
    <h2 class="mb-4">Add Actor</h2>
    @if (ViewBag.Error != null)
    {
      <div class="alert alert-danger">@ViewBag.Error</div>
    }
    <form method="post">
      <div class="mb-3">
        <label class="form-label">First Name</label>
        <input name="FirstName" class="form-control" value="@Model?.FirstName" required />
      </div>
      <div class="mb-3">
        <label class="form-label">Last Name</label>
        <input name="LastName" class="form-control" value="@Model?.LastName" required />
      </div>
      <div class="mb-3">
        <label class="form-label">Rating (0–5)</label>
        <input name="Rating" type="number" min="0" max="5" step="0.1" class="form-control" value="@Model?.Rating" required />
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">Create</button>
        <a asp-action="Actors" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
