@{ ViewData["Title"] = "401 Unauthorized"; Layout = "~/Views/Shared/_SsrLayout.cshtml"; }
<div class="text-center mt-5">
  <h1 class="display-1 text-warning">401</h1>
  <h2>Unauthorized</h2>
  <p class="text-muted">@ViewBag.Error</p>
  <a asp-controller="Auth" asp-action="Login" class="btn btn-primary mt-3">Login</a>
</div>
