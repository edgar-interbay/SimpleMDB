@{ ViewData["Title"] = "Users"; Layout = "~/Views/Shared/_SsrLayout.cshtml"; }

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Users</h2>
</div>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr><th>ID</th><th>Username</th><th>Role</th><th>Actions</th></tr>
  </thead>
  <tbody>
    @foreach (var u in (List<SimpleMovieDB.Models.UserModel>)ViewBag.Users)
    {
      <tr>
        <td>@u.Id</td>
        <td>@u.Username</td>
        <td><span class="badge @(u.Role == "Admin" ? "bg-danger" : "bg-secondary")">@u.Role</span></td>
        <td class="d-flex gap-2">
          <a asp-action="UserDetails" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">View</a>
          <a asp-action="EditUser" asp-route-id="@u.Id" class="btn btn-sm btn-outline-warning">Edit</a>
          <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="d-inline"
                onsubmit="return confirm('Delete this user?')">
            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
          </form>
        </td>
      </tr>
    }
  </tbody>
</table>
