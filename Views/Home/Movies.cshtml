@{ ViewData["Title"] = "Lista de Películas"; }

<h2>Catálogo de Películas</h2>
<table class="table table-hover mt-4">
    <thead class="table-dark">
        <tr>
            <th>Título</th>
            <th>Año</th>
            <th>Género</th>
        </tr>
    </thead>
    <tbody id="tabla-pelis"></tbody>
</table>

<script>
    fetch('/api/v1/movies')
        .then(response => response.json())
        .then(data => {
            let html = '';
            data.forEach(m => {
                html += `<tr><td>${m.title}</td><td>${m.year}</td><td>${m.genre}</td></tr>`;
            });
            document.getElementById('tabla-pelis').innerHTML = html;
        });
</script>