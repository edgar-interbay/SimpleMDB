<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Simple Movie DB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
<nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Ssr" asp-action="Index">SimpleMovieDB</a>
        <div class="navbar-collapse">
            <ul class="navbar-nav me-auto">
                @if (ViewBag.Username != null)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Ssr" asp-action="Movies">Movies</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Ssr" asp-action="Actors">Actors</a></li>
                    if (ViewBag.IsAdmin == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Ssr" asp-action="Users">Users</a></li>
                    }
                }
            </ul>
            <ul class="navbar-nav">
                @if (ViewBag.Username != null)
                {
                    <li class="nav-item"><span class="nav-link text-light">@ViewBag.Username (@(ViewBag.IsAdmin == true ? "Admin" : "Regular"))</span></li>
                    <li class="nav-item">
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light ms-2">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Register">Register</a></li>
                }
            </ul>
        </div>
    </div>
</nav>
<div class="container">
    @RenderBody()
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
